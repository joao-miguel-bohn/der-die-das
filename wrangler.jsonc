{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sprache-lernen",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Served on workers.dev and both custom domains.
	"workers_dev": true,
	"routes": [
		{ "pattern": "der-die-das.joaomiguel.com.br", "custom_domain": true },
		{ "pattern": "der-die-das.joaobohn.com.br", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sprache-lernen",
			"database_id": "e04bc82b-06e4-424e-9078-6cbfd893f422",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Every origin the app is served from; Google needs <origin>/api/auth/callback/google for each.
		"BETTER_AUTH_URL": "https://der-die-das.joaomiguel.com.br,https://der-die-das.joaobohn.com.br,https://sprache-lernen.joao-miguel-bohn.workers.dev",
		"ADMIN_EMAIL": "joao.miguel.bohn@gmail.com",
		"ALLOWED_EMAILS": ""
	}
}